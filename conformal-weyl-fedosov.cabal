name: conformal-weyl-fedosov
version: 0.1.0.0
synopsis: Conformal Weyl-Fedosov deformation architecture
description: Haskell + Lean 4 research implementation of conformal Weyl
  deformation quantization, with symbolic polynomial and numerical backends.
license: AGPL-3.0-only
build-type: Simple

library
  exposed-modules:
      ConformalWeyl.Tensor
      ConformalWeyl.Conformal
      ConformalWeyl.Curvature
      ConformalWeyl.Cotangent
      ConformalWeyl.SymplecticConnection
      ConformalWeyl.WeylAlgebra
      ConformalWeyl.Fedosov
      ConformalWeyl.CurvatureCoupling
      ConformalWeyl.ConformalTransport
      ConformalWeyl.StarProduct
      ConformalWeyl.WignerMoyal
      ConformalWeyl.Validation
  hs-source-dirs: src
  build-depends: base >=4.16 && <5, containers
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat

executable cwf-demo
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: base >=4.16 && <5, conformal-weyl-fedosov
  default-language: Haskell2010

test-suite cwf-tests
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  build-depends: base >=4.16 && <5, conformal-weyl-fedosov
  default-language: Haskell2010
